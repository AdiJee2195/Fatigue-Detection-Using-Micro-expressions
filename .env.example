# Copy to .env and adjust. Never commit .env (it is gitignored).
# Every value below is a SAFE DEFAULT: `cp .env.example .env` runs the full stack
# in demo mode with no GPU, no model file and no LLM API key.

# ---------------------------------------------------------------------------
# Gateway (Java, :8080)
# ---------------------------------------------------------------------------
SERVER_PORT=8080
# Downstream service locations. Inside docker compose these use service names.
VISION_SERVICE_URL=http://localhost:8000
NARRATIVE_WS_URL=ws://localhost:8100

# Browser origins allowed to open the WebSocket. Comma separated, no spaces needed.
# Restrict this before exposing the gateway beyond localhost.
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Maximum accepted frame payload in bytes (base64 JPEG). Larger frames are rejected.
GATEWAY_MAX_FRAME_BYTES=524288
# Consecutive dropped frames before the drop log escalates from DEBUG to WARN.
GATEWAY_WARN_AFTER_DROPS=50
# Interval of the periodic per-session METRICS log line, in seconds. 0 disables it.
GATEWAY_METRICS_INTERVAL=5
# Tomcat's WebSocket idle timeout, in ms. An active session sends ~15 frames a second
# so any I/O resets it; this only reclaims an abandoned connection (crashed tab, lost
# network). The client reconnects by itself and the engine keeps its baseline.
GATEWAY_SESSION_IDLE_TIMEOUT_MS=900000

# NOTE on frame size: there are TWO ceilings. GATEWAY_MAX_FRAME_BYTES above is the
# handler's limit — a frame above it is rejected and the session survives. The
# WebSocket container's ceiling is that limit + 64 KB of headroom; a message above
# the container ceiling is never delivered to the handler at all, and Tomcat closes
# the socket with 1009. The headroom exists so an ordinary client mistake costs a
# frame rather than the session.

# ---------------------------------------------------------------------------
# Vision service (Python FastAPI, :8000)
# ---------------------------------------------------------------------------
# stub  = deterministic synthetic telemetry. Clearly labelled DEMO / SYNTHETIC in the UI.
#         No model, no GPU, no ONNX runtime. This is the default so the stack always runs.
# onnx  = real classifier inference. Requires a valid model file.
VISION_MODE=stub

# Path to the exported classifier. The .onnx and .onnx.data files must sit together.
# Only meaningful when VISION_MODE=onnx.
FATIGUE_ONNX=../xai_narrative/models/efficientnet_fatigue.onnx

# Safety valve. When VISION_MODE=onnx and the model cannot be loaded, the service
# reports DEGRADED and refuses to serve telemetry unless this is explicitly true.
# Default false, so a misconfigured production deployment never silently serves
# synthetic data.
VISION_FALLBACK_TO_STUB=false

# Stub drift shape: the fatigue drive ramps over STUB_RAMP_S and resets each STUB_CYCLE_S.
STUB_CYCLE_S=120
STUB_RAMP_S=75

# Face detector preference order. Available: mediapipe, opencv, centre.
# The first available is used; 'centre' is a fallback crop reported as face_detected=false.
FACE_DETECTOR=mediapipe,opencv
# Directory containing fatigue_xai/ so cv_adapter is reused rather than duplicated.
# Set automatically in the Docker image; only needed for unusual layouts.
# XAI_NARRATIVE_PATH=../xai_narrative

# Bind address for the vision service. VISION_PORT wins; a generic PORT is honoured
# only when it is a usable port number. PORT=0 (which some harnesses export, and which
# uvicorn reads as "bind any free port") would otherwise move the service onto a random
# port the gateway cannot find — indistinguishable from the service being down.
VISION_PORT=8000
VISION_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Narrative XAI service (Python FastAPI, :8100)
# ---------------------------------------------------------------------------
# none   = deterministic template narratives. No API key, no model, fully functional.
# ollama = local Ollama server.
# openai = any OpenAI-compatible /v1/chat/completions endpoint (vLLM, llama.cpp).
NARRATIVE_LLM=none

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---- Groq (NARRATIVE_LLM=groq) ---------------------------------------------
# Keep the real key in your untracked .env. Never in the frontend, never committed.
# Get one from https://console.groq.com/ and choose a model your account supports.
# GROQ_MODEL is required: no model name is hard-coded in the source, because the
# catalogue changes and a stale default would fail confusingly instead of clearly.
# GROQ_API_KEY=
# GROQ_MODEL=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Response deadline for one explanation, in seconds. Bounds how long a slow
# provider can delay a narrative; the deterministic text is used if it expires.
# GROQ_TIMEOUT_SECONDS=8
# Output cap. Explanations are 2-3 sentences, so this only stops a runaway reply.
# NOTE: a reasoning model (Groq's gpt-oss family, for example) streams its chain of
# thought on a channel this client ignores, but those tokens still count against this
# cap -- at 200 the answer can come back truncated or empty. Observed live with
# openai/gpt-oss-20b: 2000 produced complete, guard-passing answers.
# GROQ_MAX_TOKENS=200
#
# A missing key or model is NOT a startup failure: /health reports the provider as
# disabled, and narratives come from the deterministic template. Verify with:
#   .venv/bin/python scripts/groq_smoke.py

# Used only when NARRATIVE_LLM=openai. Note: a vLLM server usually also defaults to
# :8000, which collides with the vision service — move it (the example uses :8300).
OPENAI_COMPAT_URL=http://localhost:8300/v1
OPENAI_COMPAT_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
# OPENAI_COMPAT_KEY=

# Override the rule engine's thresholds without touching code.
# RULES_JSON=./xai_narrative/rules.default.json

# ---------------------------------------------------------------------------
# Frontend (Vite dev server :5173; nginx-served build maps :5173 -> container :8080)
# ---------------------------------------------------------------------------
# Baked in at build time by Vite. Runtime precedence for the gateway URL is:
#   ?gateway= URL param  >  VITE_GATEWAY_WS  >  ws://localhost:8080
# For the session id it is:
#   ?session= URL param  >  id remembered in localStorage  >  VITE_SESSION_ID
# The remembered id wins over this default on purpose: a reload must not silently
# start a new operator session, because reusing the id is what preserves the engine's
# per-operator baseline.
# NOTE: the browser connects to the gateway directly, so this must be an address the
# BROWSER can reach — not a compose-internal service name. nginx does not proxy the
# WebSocket, deliberately: a proxy would put a queue in front of a pipeline whose
# whole design is drop-don't-queue.
VITE_GATEWAY_WS=ws://localhost:8080
# Default session id when nothing is remembered yet. Any string.
VITE_SESSION_ID=operator-001
# Capture settings applied when a real camera is in use.
VITE_CAPTURE_FPS=15
VITE_CAPTURE_MAX_WIDTH=640
VITE_JPEG_QUALITY=0.6

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
